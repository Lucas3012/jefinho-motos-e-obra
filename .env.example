# ------------------------------------------------------------------
# Copie este arquivo para ".env.local" e preencha com os dados do
# seu projeto Supabase (Supabase > Project Settings > API).
# No Render, essas mesmas variáveis vão em Environment Variables.
# ------------------------------------------------------------------

# URL pública do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon / publishable) - segura para o navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_chave_anon

# Chave de serviço (service_role) - só no servidor, NUNCA no navegador
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_chave_service_role

# Número do WhatsApp da loja (formato: 55DDDNÚMERO)
NEXT_PUBLIC_WHATSAPP=5511999999999

# Endereço de e-mail de destino das mensagens (opcional)
NEXT_PUBLIC_EMAIL=contato@jefinhomotos.com.br
